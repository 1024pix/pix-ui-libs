{
  "name": "vue-test-app",
  "version": "0.0.0",
  "private": true,
  "description": "Tests of @1024pix/nebulix-vue, run against its built package",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "start": "vitest",
    "test": "vitest run",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:format": "prettier . --cache --check",
    "lint:format:fix": "prettier . --cache --write",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@1024pix/eslint-plugin": "3.1.1",
    "@1024pix/nebulix-vue": "workspace:*",
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "catalog:",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/compiler-dom": "catalog:",
    "@vue/server-renderer": "catalog:",
    "@vue/tsconfig": "0.9.1",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.2",
    "vite": "catalog:",
    "vitest": "5.1.1",
    "vue": "catalog:",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "catalog:"
  }
}
