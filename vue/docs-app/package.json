{
  "name": "vue-docs-app",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation of @1024pix/nebulix-vue",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "start": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "vitepress build",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:format": "prettier . --cache --check",
    "lint:format:fix": "prettier . --cache --write",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@1024pix/nebulix-vue": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@1024pix/eslint-plugin": "3.1.1",
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "@vue/tsconfig": "0.9.1",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "sass-embedded": "1.108.2",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.2",
    "vitepress": "1.6.4",
    "vue-component-meta": "catalog:",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "catalog:"
  }
}
