{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "types"],
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "@1024pix/nebulix-ember-docs/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types",
      "kolay/virtual"
    ]
  }
}
