{
  "name": "test-app",
  "version": "0.0.0",
  "private": true,
  "description": "Test app for Nebulix-ember",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:format": "prettier . --cache --check",
    "lint:format:fix": "prettier . --cache --write",
    "lint:template": "ember-template-lint .",
    "lint:template:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@1024pix/ember-testing-library": "^3.0.41",
    "@1024pix/eslint-plugin": "^3.0.4",
    "@1024pix/nebulix-ember": "workspace:*",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.22",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.3",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.6",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.9",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.10.0",
    "@glint/template": "^1.8.0",
    "@glint/tsserver-plugin": "^2.7.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.5",
    "@types/qunit": "^2.19.14",
    "@types/rsvp": "^4.0.9",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.2.4",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~7.2.0",
    "ember-cli-babel": "^8.3.1",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.2.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.7",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "sass-embedded": "^1.102.0",
    "sinon": "^21.0.0",
    "testem": "^3.20.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "ember": {
    "edition": "octane"
  },
  "engines": {
    "node": "24.*"
  }
}
