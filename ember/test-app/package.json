{
  "name": "test-app",
  "version": "0.0.0",
  "private": true,
  "description": "Test app for Nebulix-ember",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:template": "ember-template-lint .",
    "lint:template:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@1024pix/ember-testing-library": "workspace:*",
    "@1024pix/eslint-plugin": "3.0.12",
    "@1024pix/nebulix-ember": "workspace:*",
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.9",
    "@babel/runtime": "7.29.10",
    "@ember/app-tsconfig": "2.1.0",
    "@ember/optional-features": "3.0.0",
    "@ember/string": "4.0.1",
    "@ember/test-helpers": "5.7.0",
    "@ember/test-waiters": "4.1.2",
    "@embroider/compat": "4.1.27",
    "@embroider/config-meta-loader": "1.0.0",
    "@embroider/core": "4.6.9",
    "@embroider/legacy-inspector-support": "0.1.3",
    "@embroider/macros": "1.21.3",
    "@embroider/router": "3.0.6",
    "@embroider/vite": "1.7.15",
    "@eslint/js": "9.39.5",
    "@glimmer/component": "2.1.1",
    "@glint/ember-tsc": "1.11.6",
    "@glint/template": "1.9.0",
    "@glint/tsserver-plugin": "2.7.9",
    "@rollup/plugin-babel": "7.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/qunit": "2.19.14",
    "@types/rsvp": "4.0.9",
    "babel-plugin-ember-template-compilation": "4.0.1",
    "concurrently": "10.0.6",
    "decorator-transforms": "2.4.0",
    "ember-cli": "7.3.0",
    "ember-cli-babel": "8.3.2",
    "ember-load-initializers": "3.0.1",
    "ember-modifier": "4.3.0",
    "ember-qunit": "9.2.0",
    "ember-resolver": "13.2.0",
    "ember-source": "7.3.0",
    "ember-template-lint": "7.9.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "13.6.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-qunit": "8.2.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-ember-template-tag": "2.1.8",
    "qunit": "3.0.0",
    "qunit-dom": "3.6.0",
    "sass-embedded": "1.105.2",
    "sinon": "22.1.0",
    "testem": "3.21.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": "24.22.0",
    "pnpm": ">= 11"
  },
  "ember": {
    "edition": "octane"
  }
}
