      "./components/pix-label-wrapped.js": "./dist/_app_/components/pix-label-wrapped.js",
      "./components/pix-label.js": "./dist/_app_/components/pix-label.js",
      "./components/pix-multi-select.js": "./dist/_app_/components/pix-multi-select.js",
      "./components/pix-radio-button.js": "./dist/_app_/components/pix-radio-button.js",
      "./components/pix-search-input.js": "./dist/_app_/components/pix-search-input.js",
      "./components/pix-select-list.js": "./dist/_app_/components/pix-select-list.js",
      "./components/pix-select.js": "./dist/_app_/components/pix-select.js",
      "./components/pix-textarea.js": "./dist/_app_/components/pix-textarea.js",
      "./components/pix-icon.js": "./dist/_app_/components/pix-icon.js",
      "./components/pix-block.js": "./dist/_app_/components/pix-block.js",
      "./components/pix-app-layout.js": "./dist/_app_/components/pix-app-layout.js",
      "./components/pix-breadcrumb.js": "./dist/_app_/components/pix-breadcrumb.js",
      "./components/pix-navigation-button.js": "./dist/_app_/components/pix-navigation-button.js",
      "./components/pix-navigation-separator.js": "./dist/_app_/components/pix-navigation-separator.js",
      "./components/pix-navigation-shrunk-button.js": "./dist/_app_/components/pix-navigation-shrunk-button.js",
      "./components/pix-navigation.js": "./dist/_app_/components/pix-navigation.js",
      "./components/pix-pagination.js": "./dist/_app_/components/pix-pagination.js",
      "./components/pix-segmented-control.js": "./dist/_app_/components/pix-segmented-control.js",
      "./components/pix-step.js": "./dist/_app_/components/pix-step.js",
      "./components/pix-stepper.js": "./dist/_app_/components/pix-stepper.js",
