      "./components/pix-toast.js": "./dist/_app_/components/pix-toast.js",
      "./components/pix-checkbox.js": "./dist/_app_/components/pix-checkbox.js",
      "./components/pix-code.js": "./dist/_app_/components/pix-code.js",
      "./components/pix-filterable-and-searchable-select.js": "./dist/_app_/components/pix-filterable-and-searchable-select.js",
      "./components/pix-input-base.js": "./dist/_app_/components/pix-input-base.js",
