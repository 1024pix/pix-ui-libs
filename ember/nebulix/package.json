      "./components/pix-side-panel.js": "./dist/_app_/components/pix-side-panel.js",
      "./components/pix-tooltip.js": "./dist/_app_/components/pix-tooltip.js",
      "./helpers/icons.js": "./dist/_app_/helpers/icons.js",
      "./helpers/variants.js": "./dist/_app_/helpers/variants.js",
      "./modifiers/modal-dialog.js": "./dist/_app_/modifiers/modal-dialog.js",
      "./modifiers/on-arrow-down-up-action.js": "./dist/_app_/modifiers/on-arrow-down-up-action.js",
      "./modifiers/on-enter-action.js": "./dist/_app_/modifiers/on-enter-action.js",
      "./modifiers/on-escape-action.js": "./dist/_app_/modifiers/on-escape-action.js",
      "./modifiers/on-space-action.js": "./dist/_app_/modifiers/on-space-action.js",
      "./modifiers/on-window-resize.js": "./dist/_app_/modifiers/on-window-resize.js",
      "./modifiers/trap-focus.js": "./dist/_app_/modifiers/trap-focus.js",
      "./services/element-helper.js": "./dist/_app_/services/element-helper.js",
      "./services/pix-toast.js": "./dist/_app_/services/pix-toast.js",
      "./services/shrink-navigation-service.js": "./dist/_app_/services/shrink-navigation-service.js"
    },
    "public-assets": {
      "./src/assets/fonts/Nunito/Nunito-Bold.woff2": "/@1024pix/nebulix-ember/fonts/Nunito/Nunito-Bold.woff2",
      "./src/assets/fonts/Nunito/Nunito-ExtraBold.woff2": "/@1024pix/nebulix-ember/fonts/Nunito/Nunito-ExtraBold.woff2",
      "./src/assets/fonts/Nunito/Nunito-Regular.woff2": "/@1024pix/nebulix-ember/fonts/Nunito/Nunito-Regular.woff2",
