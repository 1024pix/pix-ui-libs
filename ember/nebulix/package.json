      "./components/feedback/pix-banner-alert.js": "./dist/_app_/components/feedback/pix-banner-alert.js",
      "./components/feedback/pix-notification-alert.js": "./dist/_app_/components/feedback/pix-notification-alert.js",
      "./components/feedback/pix-toast-container.js": "./dist/_app_/components/feedback/pix-toast-container.js",
      "./components/feedback/pix-toast.js": "./dist/_app_/components/feedback/pix-toast.js",
      "./components/forms/pix-checkbox.js": "./dist/_app_/components/forms/pix-checkbox.js",
      "./components/forms/pix-code.js": "./dist/_app_/components/forms/pix-code.js",
      "./components/forms/pix-input-base.js": "./dist/_app_/components/forms/pix-input-base.js",
      "./components/forms/pix-input-code.js": "./dist/_app_/components/forms/pix-input-code.js",
      "./components/forms/pix-input-password.js": "./dist/_app_/components/forms/pix-input-password.js",
      "./components/forms/pix-input.js": "./dist/_app_/components/forms/pix-input.js",
      "./components/forms/pix-label-wrapped.js": "./dist/_app_/components/forms/pix-label-wrapped.js",
      "./components/forms/pix-label.js": "./dist/_app_/components/forms/pix-label.js",
      "./components/forms/pix-radio-button.js": "./dist/_app_/components/forms/pix-radio-button.js",
      "./components/forms/pix-search-input.js": "./dist/_app_/components/forms/pix-search-input.js",
      "./components/forms/pix-select-list.js": "./dist/_app_/components/forms/pix-select-list.js",
      "./components/forms/pix-textarea.js": "./dist/_app_/components/forms/pix-textarea.js",
      "./components/graphics/pix-icon.js": "./dist/_app_/components/graphics/pix-icon.js",
      "./components/layout/pix-block.js": "./dist/_app_/components/layout/pix-block.js",
      "./components/navigation/pix-app-layout.js": "./dist/_app_/components/navigation/pix-app-layout.js",
      "./components/navigation/pix-breadcrumb.js": "./dist/_app_/components/navigation/pix-breadcrumb.js",
      "./components/navigation/pix-navigation-button.js": "./dist/_app_/components/navigation/pix-navigation-button.js",
      "./components/navigation/pix-navigation-separator.js": "./dist/_app_/components/navigation/pix-navigation-separator.js",
      "./components/navigation/pix-navigation-shrunk-button.js": "./dist/_app_/components/navigation/pix-navigation-shrunk-button.js",
      "./components/navigation/pix-navigation.js": "./dist/_app_/components/navigation/pix-navigation.js",
      "./components/navigation/pix-segmented-control.js": "./dist/_app_/components/navigation/pix-segmented-control.js",
      "./components/navigation/pix-step.js": "./dist/_app_/components/navigation/pix-step.js",
      "./components/navigation/pix-stepper.js": "./dist/_app_/components/navigation/pix-stepper.js",
      "./components/navigation/pix-tabs.js": "./dist/_app_/components/navigation/pix-tabs.js",
      "./components/overlay/pix-modal-header.js": "./dist/_app_/components/overlay/pix-modal-header.js",
      "./components/overlay/pix-modal.js": "./dist/_app_/components/overlay/pix-modal.js",
      "./components/overlay/pix-overlay.js": "./dist/_app_/components/overlay/pix-overlay.js",
      "./components/overlay/pix-side-panel.js": "./dist/_app_/components/overlay/pix-side-panel.js",
      "./components/overlay/pix-tooltip.js": "./dist/_app_/components/overlay/pix-tooltip.js",
      "./helpers/icons.js": "./dist/_app_/helpers/icons.js",
      "./helpers/variants.js": "./dist/_app_/helpers/variants.js",
      "./modifiers/modal-dialog.js": "./dist/_app_/modifiers/modal-dialog.js",
      "./modifiers/on-arrow-down-up-action.js": "./dist/_app_/modifiers/on-arrow-down-up-action.js",
      "./modifiers/on-enter-action.js": "./dist/_app_/modifiers/on-enter-action.js",
      "./modifiers/on-escape-action.js": "./dist/_app_/modifiers/on-escape-action.js",
      "./modifiers/on-space-action.js": "./dist/_app_/modifiers/on-space-action.js",
      "./modifiers/on-window-resize.js": "./dist/_app_/modifiers/on-window-resize.js",
      "./modifiers/trap-focus.js": "./dist/_app_/modifiers/trap-focus.js",
      "./services/pix-toast.js": "./dist/_app_/services/pix-toast.js",
      "./services/shrink-navigation-service.js": "./dist/_app_/services/shrink-navigation-service.js"
    }
  }
}
