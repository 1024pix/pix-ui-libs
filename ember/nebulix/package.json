{
  "name": "@1024pix/nebulix-ember",
  "version": "0.0.0",
  "description": "Library implementing Pix Design-System components for Ember app",
  "keywords": [
    "ember-addon"
  ],
  "license": "AGPL-3.0",
  "author": "GIP Pix",
  "exports": {
    ".": "./dist/index.js",
    "./addon-main.js": "./addon-main.cjs",
    "./package.json": "./package.json",
    "./*.scss": "./dist/*.scss",
    "./*": "./dist/*.js"
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "src/assets"
  ],
  "scripts": {
    "build": "rollup --config",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto",
    "lint:format": "prettier . --cache --check",
    "lint:format:fix": "prettier . --cache --write",
    "lint:template": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:template:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "prepack": "rollup --config",
    "prepare": "rollup --config",
    "svg:generate-sprite": "pnpm svg:compile && pnpm svg:optimize && pnpm run svg:rename-id",
    "svg:compile": "svg-sprite -C 'tooling/generate-svg-sprite/svg-sprite.config.json' 'tooling/generate-svg-sprite/icons/*.svg'",
    "svg:optimize": "svgo --config='./tooling/generate-svg-sprite/svgo.config.js' -i 'src/assets/svg/' -o 'src/assets/svg/'",
    "svg:rename-id": "bash ./tooling/generate-svg-sprite/rename-icon-id-in-sprite.sh"
  },
  "peerDependencies": {
    "@glimmer/component": ">= 2.0.0",
    "ember-source": ">= 6.0.0"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.8.9",
    "@formatjs/intl": "^4.1.19",
    "decorator-transforms": "^2.2.2",
    "ember-click-outside": "^6.1.1",
    "ember-lifeline": "^7.1.0",
    "ember-modifier": "^4.3.0",
    "ember-popperjs": "^3.0.0",
    "ember-truth-helpers": "^5.0.0",
    "tracked-toolbox": "^3.0.0"
  },
  "devDependencies": {
    "@1024pix/eslint-plugin": "^3.0.4",
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/runtime": "^7.25.6",
    "@embroider/addon-dev": "^8.1.0",
    "@embroider/compat": "^4.1.22",
    "@embroider/macros": "^1.20.1",
    "@eslint/js": "^9.17.0",
    "@glimmer/component": "^2.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.0.1",
    "ember-source": "~7.2.0",
    "ember-template-lint": "^7.9.0",
    "eslint": "^9.17.0",
    "eslint-plugin-ember": "^12.3.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "publint": "^0.3.16",
    "rollup": "^4.22.5",
    "svg-sprite": "^2.0.4",
    "svgo": "^4.0.2"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/pix-button-base.js": "./dist/_app_/components/pix-button-base.js",
