{
  "name": "@1024pix/nebulix-styles",
  "version": "0.0.0",
  "private": true,
  "description": "Internal, framework-agnostic styles, fonts and icon sprite of the Pix Design-System. Not published: framework packages embed it.",
  "keywords": [
    "design-system",
    "scss",
    "svg-sprite"
  ],
  "license": "AGPL-3.0",
  "author": "GIP Pix",
  "repository": {
    "url": "https://github.com/1024pix/pix-ui-libs"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./icons": {
      "types": "./src/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./scss/*": "./src/*",
    "./fonts/*": "./assets/fonts/*",
    "./svg/*": "./dist/svg/*"
  },
  "scripts": {
    "build": "node tooling/generate-svg-sprite/build-sprite.mjs",
    "lint": "pnpm lint:format",
    "lint:fix": "pnpm lint:format:fix",
    "lint:format": "prettier . --cache --check",
    "lint:format:fix": "prettier . --cache --write"
  },
  "devDependencies": {
    "prettier": "3.10.0",
    "svg-sprite": "2.0.4",
    "svgo": "4.1.0"
  }
}
