{
  "name": "@1024pix/pix-ui-libs",
  "version": "0.0.0",
  "private": true,
  "description": "All libraries for Pix frontend apps",
  "license": "AGPL-3.0",
  "author": "GIP Pix",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/1024pix/pix-ui-libs.git"
  },
  "homepage": "https://github.com/1024pix/pix-ui-libs#readme",
  "scripts": {
    "build": "pnpm --filter @1024pix/nebulix-ember build",
    "dev": "concurrently \"pnpm --filter @1024pix/nebulix-ember dev\" \"pnpm --filter test-app start\" --names \"addon,app\" --prefixColors auto",
    "doc": "concurrently \"pnpm --filter @1024pix/nebulix-ember dev\" \"pnpm --filter docs-app start\" --names \"addon,app\" --prefixColors auto",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm build && pnpm --filter test-app test",
    "ci:publish": "pnpm publish -r --access=public"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/sinon": "22.0.0",
    "concurrently": "10.0.5"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": ">= 11"
  }
}
