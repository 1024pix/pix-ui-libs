{
  "name": "@1024pix/pix-ui-libs",
  "version": "0.0.0",
  "private": true,
  "description": "Project managing all front-end utilities",
  "license": "AGPL-3.0",
  "author": "GIP Pix",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/1024pix/pix-ui-libs.git"
  },
  "homepage": "https://github.com/1024pix/pix-ui-libs#readme",
  "scripts": {
    "build": "pnpm --filter @1024pix/nebulix-ember build",
    "dev": "concurrently \"pnpm --filter @1024pix/nebulix-ember build --watch\" \"pnpm --filter test-app start\" --names \"addon,app\" --prefixColors auto",
    "lint": "pnpm -r lint",
    "test": "pnpm build && pnpm --filter test-app test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.*",
    "pnpm": ">= 11"
  }
}
